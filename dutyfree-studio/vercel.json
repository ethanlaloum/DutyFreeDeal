{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "rm -rf public && mkdir public && cp -R index.html css js assets public/",
  "outputDirectory": "public",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/r/:release/:path*", "destination": "/:path*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
